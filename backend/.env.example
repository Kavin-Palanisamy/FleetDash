PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fleetdash
# Set to true for ephemeral in-memory MongoDB without a local MongoDB service
USE_IN_MEMORY_DB=false
CLIENT_ORIGIN=http://localhost:5173
API_KEY=change-me
OFFLINE_AFTER_SECONDS=15
BATCH_FLUSH_MS=2000
# Rate limiting: set RATE_LIMIT_ENABLED=false to disable during load testing
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
